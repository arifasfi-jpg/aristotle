DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
ARISTOTLE_SESSION_COOKIE="aristotle_session"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
USD_INR="88"
MODEL_INPUT_USD_PER_MILLION="0.20"
MODEL_OUTPUT_USD_PER_MILLION="1.20"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
TAVILY_API_KEY=""
# Demo checkout (no real payment). Only honoured when "true" AND not in Vercel Production.
# Never set this in Production. A missing Razorpay key never enables demo mode.
DEMO_MODE="false"
# Hippoturtle model gateway: whichever key is set is used (gemini → openai → anthropic), or force one:
HIPPO_AI_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# Per-work payments: "early_access" (default, AI execution not charged, actual cost recorded) | "razorpay" (reserved, pending integration)
HIPPO_WORK_PAYMENTS="early_access"
# Share of a paid report's cost limit that research escalation may spend widening searches (default 0.6).
HIPPO_RESEARCH_SPEND_SHARE="0.6"
