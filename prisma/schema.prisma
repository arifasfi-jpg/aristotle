generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  // Optional: new visitors get a fresh account with no email. Email is never used to authenticate.
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  audits    Audit[]
  founder   Founder?
  jobs      Job[]
  conversations Conversation[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Audit {
  id            String      @id @default(cuid())
  userId        String
  idea          String
  sector        String
  geography     String?
  stage         String?
  founderName   String?
  contactEmail  String?
  reportLanguage String      @default("Simple English")
  assumptions   String
  report        String
  status        String      @default("completed")
  pricePaise    Int         @default(9900)
  computePaise  Int         @default(0)
  marginPaise   Int         @default(0)
  paymentStatus String      @default("pending")
  paymentRef    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts     ProjectFile[]
  @@index([userId, createdAt])
}

model ProjectFile {
  id        String   @id @default(cuid())
  auditId   String
  path      String
  content   String
  createdAt DateTime @default(now())
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  @@unique([auditId, path])
}

// ===========================================================================
// HIPPOTURTLE — company-building organisation (additive; Aristotle tables above are unchanged)
// Enumerations are stored as strings and validated in src/lib/hippo/types.ts.
// ===========================================================================

model Founder {
  id             String         @id @default(cuid())
  userId         String         @unique
  name           String?
  timeCommitment String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizations  Organization[]
}

model Organization {
  id         String           @id @default(cuid())
  founderId  String
  name       String
  isDemo     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  founder    Founder          @relation(fields: [founderId], references: [id], onDelete: Cascade)
  objectives Objective[]
  ideas      BusinessIdea[]
  work       Work[]
  providers  Provider[]
  memory     BusinessMemory[]
  activity   ActivityLog[]
  @@index([founderId])
}

model Objective {
  id                String             @id @default(cuid())
  organizationId    String
  text              String
  mode              String             @default("IDEA")
  stage             String             @default("FOUNDER_OBJECTIVE")
  understanding     Json?
  auditId           String?            @unique
  pathways          Json?
  selectedPathways  Json?
  isDemo            Boolean            @default(false)
  companyName       String?            // per-objective business name; immutable after creation
  lastError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  idea              BusinessIdea?
  questions         ResearchQuestion[]
  findings          ResearchFinding[]
  evidence          Evidence[]
  memo              DecisionMemo?
  work              Work[]
  outcomes          Outcome[]
  @@index([organizationId, createdAt])
}

model BusinessIdea {
  id                  String       @id @default(cuid())
  organizationId      String
  objectiveId         String       @unique
  summary             String
  customer            String
  payer               String
  offering            String
  revenueMechanism    String
  keyActivities       Json
  regulatedActivities Json
  createdAt           DateTime     @default(now())
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objective           Objective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
}

model ResearchQuestion {
  id           String    @id @default(cuid())
  objectiveId  String
  code         String
  category     String
  question     String
  whyItMatters String
  query        String
  status       String
  createdAt    DateTime  @default(now())
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  @@unique([objectiveId, code])
}

model ResearchFinding {
  id           String    @id @default(cuid())
  objectiveId  String
  code         String
  questionCode String
  statement    String
  quote        String
  sourceTitle  String
  sourceUrl    String
  retrievedAt  DateTime?
  geography    String
  confidence   String
  createdAt    DateTime  @default(now())
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  @@unique([objectiveId, code])
}

model Evidence {
  id          String    @id @default(cuid())
  objectiveId String
  claim       String
  type        String
  status      String
  sourceRefs  Json
  confidence  String
  validation  String
  createdAt   DateTime  @default(now())
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  @@index([objectiveId])
}

model DecisionMemo {
  id               String    @id @default(cuid())
  objectiveId      String    @unique
  auditId          String
  content          Json
  pathways         Json?
  founderChecklist Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  objective        Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
}

model Work {
  id                 String          @id @default(cuid())
  organizationId     String
  objectiveId        String
  title              String
  description        String
  deliverable        String
  capability         String
  status             String          @default("DRAFT")
  priority           Int             @default(3)
  estimatedCost      Float?
  currency           String          @default("INR")
  executionMode      String?
  selectedProviderId String?
  pathwayId          String?
  aiExecutable       Boolean         @default(true)
  paymentStatus      String          @default("NOT_REQUIRED")
  amountPaise        Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  completedAt        DateTime?
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objective          Objective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  brief              WorkBrief?
  estimates          CostEstimate[]
  quotes             Quote[]
  executions         Execution[]
  outcomes           Outcome[]
  @@index([organizationId, status])
  @@index([objectiveId])
}

model WorkBrief {
  id              String   @id @default(cuid())
  workId          String   @unique
  objective       String
  deliverable     String
  inputs          Json
  constraints     Json
  successCriteria Json
  expectedOutput  String
  outOfScope      Json
  effort          Json
  provider        String?
  model           String?
  createdAt       DateTime @default(now())
  work            Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model CostEstimate {
  id        String   @id @default(cuid())
  workId    String
  mode      String
  low       Float
  high      Float
  currency  String   @default("INR")
  label     String
  basis     String
  breakdown Json
  drivers   Json
  createdAt DateTime @default(now())
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  @@index([workId])
}

model Provider {
  id             String        @id @default(cuid())
  organizationId String?
  name           String
  tier           String
  capability     String
  website        String?
  addedBy        String
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes         Quote[]
  @@index([organizationId])
}

model Quote {
  id             String   @id @default(cuid())
  workId         String
  providerId     String
  amount         Float
  currency       String   @default("INR")
  includes       Json
  excludes       Json
  turnaroundDays Int?
  revisions      Int?
  status         String   @default("RECEIVED")
  source         String
  comparison     Json?
  createdAt      DateTime @default(now())
  work           Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@index([workId])
}

model Execution {
  id            String    @id @default(cuid())
  workId        String
  mode          String
  status        String
  provider      String?
  model         String?
  input         Json
  output        String?
  outputSummary String?
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  costInr       Float     @default(0)
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  work          Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  @@index([workId])
}

model Outcome {
  id          String    @id @default(cuid())
  objectiveId String
  workId      String?
  summary     String
  metrics     Json
  recordedBy  String
  // Signals (Moves): which Move this responds to, how strong it is, who observed it, and its proof.
  moveId      String?
  rung        Int?      // 3 action · 4 signal · 5 verified outcome
  source      String?   // FOUNDER_REPORTED | SYSTEM_OBSERVED
  polarity    String?   // POSITIVE | NEGATIVE | NEUTRAL
  proof       String?
  external    Boolean?  // false when it came from the founder's own session (a self-test)
  createdAt   DateTime  @default(now())
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  work        Work?     @relation(fields: [workId], references: [id], onDelete: Cascade)
  @@index([objectiveId])
}

model BusinessMemory {
  id             String       @id @default(cuid())
  organizationId String
  objectiveId    String?
  kind           String
  title          String
  detail         String
  value          String?
  status         String
  source         String?
  sourceUrl      String?
  owner          String
  confidence     String?
  refType        String?
  refId          String?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, occurredAt])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  objectiveId    String?
  workId         String?
  type           String
  message        String
  actor          String
  meta           Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------- AI COST LEDGER (Phase 1)
// One append-only row per model or search call, written by the metered gateway (src/lib/ai-usage.ts).
// Ids are plain strings (no foreign keys) so the ledger survives deletes and never blocks a business write.
model AiUsage {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  kind            String   // MODEL | SEARCH
  purpose         String   // CONVERSATION | ARISTOTLE | RESEARCH | OPPORTUNITY | THINK_TANK | WORK | OTHER
  task            String   // e.g. research-plan, research-extract, research-search, decision, scope-classifier, understand, explore, plan, brief, execute
  tier            Int?
  provider        String
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cachedTokens    Int      @default(0)
  reasoningTokens Int      @default(0)
  searchCalls     Int      @default(0)
  searchCredits   Int      @default(0)
  estimatedInr    Float?
  costInr         Float    @default(0)
  priceSource     String   // VERIFIED_PRICE | UNVERIFIED_PRICE | UNPRICED
  priceId         String?
  usdInr          Float
  durationMs      Int      @default(0)
  retries         Int      @default(0)
  outcome         String   // SUCCESS | PROVIDER_ERROR | INVALID_OUTPUT | TIMEOUT | FAILED_BEFORE_PROVIDER | CANCELLED | UNKNOWN_PROVIDER_OUTCOME | REFUSED_BUDGET
  costStatus      String   @default("ESTIMATED") // ACTUAL (provider-reported usage × verified price) | ESTIMATED (uncertain usage or unverified price) | NONE (never reached the provider) | UNPRICED
  error           String?
  userId          String?
  founderId       String?
  organizationId  String?
  objectiveId     String?
  workId          String?
  auditId         String?
  parentType      String?  // TURN | JOB | WORK | AUDIT | REQUEST (only REQUEST/AUDIT/WORK are used before Phase 5)
  parentId        String?
  @@index([createdAt])
  @@index([purpose, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([auditId])
  @@index([provider, model])
}

// Price per provider/model (tokens) or per search credit. The newest active row with effectiveFrom <= now applies.
model ModelPrice {
  id                    String   @id @default(cuid())
  provider              String
  model                 String
  inputUsdPerMTok       Float?
  outputUsdPerMTok      Float?
  cachedInputUsdPerMTok Float?
  usdPerCredit          Float?
  reasoningUsdPerMTok   Float?   // thinking/reasoning tokens; null = billed at the output rate
  currency              String   @default("USD")
  effectiveFrom         DateTime @default(now())
  active                Boolean  @default(true)
  verificationStatus    String   @default("UNVERIFIED") // VERIFIED (checked against the provider's price page) | UNVERIFIED
  verifiedAt            DateTime?
  source                String?  // where the price came from (URL / note)
  createdAt             DateTime @default(now())
  @@unique([provider, model, effectiveFrom])
  @@index([provider, model])
}

// Fixed-window request counters for AI endpoints (abuse / cost protection). Atomic upsert per (key, window).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  @@id([key, windowStart])
  @@index([windowStart])
}

// ---------------------------------------------------------------- DURABLE JOB RUNTIME (Phase 2)
// One row per unit of long-running AI work (first user: the paid Aristotle audit). Postgres is the queue: a worker
// claims a job with an atomic compare-and-set on (status, lease) and owns it until `leaseUntil`; a dead worker's lease
// expires and another worker resumes from `checkpoint`. Every job belongs to one user (owner) — every lookup is scoped.
model Job {
  id                String    @id @default(cuid())
  type              String    // ARISTOTLE_AUDIT
  userId            String    // owner (tenant)
  organizationId    String?
  subjectType       String?   // AUDIT
  subjectId         String?
  dedupeKey         String    @unique // one job per business object (e.g. ARISTOTLE_AUDIT:<auditId>)
  status            String    @default("QUEUED") // QUEUED | RUNNING | WAITING | COMPLETED | FAILED | CANCELLED
  progress          String    @default("QUEUED") // human-readable stage: UNDERSTANDING | RESEARCHING | ANALYSING | GENERATING_REPORT | COMPLETED
  checkpoint        String?   // last durable step reached (PLANNED | RESEARCHED | DECIDED | SAVED)
  state             Json?     // step outputs needed to resume (e.g. the decided report before it is saved)
  budgetScopeType   String    // cost-governor scope the job spends from (AiUsage parentType)
  budgetScopeId     String
  budgetInr         Float     // included internal cost limit
  costInr           Float     @default(0) // booked cost (AiUsage, refreshed by the worker)
  reservedInr       Float     @default(0) // active reservations at the last refresh
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  lastError         String?
  waitingReason     String?
  runAfter          DateTime  @default(now())
  leaseOwner        String?
  leaseUntil        DateTime?
  cancelRequestedAt DateTime?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, runAfter])
  @@index([userId, createdAt])
}

// Budget reservations held while a governed provider call is in flight. Postgres-backed so concurrent workers in
// different processes cannot jointly overspend: reserve = (advisory lock on the scope) + spent + active reservations +
// new ≤ limit, in one transaction. Released after the call's AiUsage row is written. A reservation whose worker died is
// expired and converted into an ESTIMATED AiUsage row at its worst case (the call may have been billed).
model CostReservation {
  id         String    @id @default(cuid())
  scopeType  String
  scopeId    String
  amountInr  Float
  spec       Json      // call spec + attribution, used if the reservation expires unreleased
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  @@index([scopeType, scopeId, releasedAt])
}

// ---------------------------------------------------------------- HIPPO CONVERSATION (Phase 3A)
// The founder's conversation with Hippo before (and around) the engine. `state` is the minimum structured business
// state the conversation builds (src/lib/hippo/conversation.ts): objective, target, current state, constraints,
// known facts (with provenance), unknowns, preferences, summary. Owner-scoped by userId (cookie session).
model Conversation {
  id          String                @id @default(cuid())
  userId      String
  status      String                @default("ACTIVE") // ACTIVE | PAUSED | HANDED_OFF | ARCHIVED
  phase       String                @default("DISCOVER") // DISCOVER | PROPOSED | HANDED_OFF
  state       Json
  objectiveId String?               // the Objective created at handoff (existing Aristotle/Mogli pipeline)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ConversationMessage[]
  @@index([userId, updatedAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // HIPPO | FOUNDER
  text           String
  meta           Json?        // intent, handoff info (never prompts or model output beyond the reply)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------- Moves (HIPPO_MOVES)
// The Move: one executable unit of business progress. Exactly one is current per objective (partial unique index in
// the migration). Work/Execution hold documents Hippo prepares; PublicPage is the native public surface.
model Move {
  id                   String    @id @default(cuid())
  organizationId       String
  objectiveId          String
  conversationId       String?
  kind                 String    // RESEARCH | BUILD | SELL | TALK | TEST | PRICE | BUY | CONTACT | PUBLISH | DECIDE | STOP | PIVOT | VALIDATE | EXECUTE
  owner                String    // HIPPO | FOUNDER — who performs the external step
  title                String    // what we're doing
  why                  String
  bet                  String    // the working hypothesis this Move tests (internal)
  hippoWill            String    // what Hippo will do
  needs                Json      // string[] — what Hippo needs from the founder
  costInr              Float?
  costBasis            String
  expectedSignal       String
  artifactType         String    @default("NONE") // NONE | DOCUMENT | PUBLIC_PAGE | DEEP_RESEARCH
  artifactBrief        String    @default("")
  alternative          Json?
  routeKey             String    // normalised approach, to stop repeating a failed route
  consequential        Boolean   @default(false)
  consequentialReasons Json      // string[] — decided by the server, never lowered by the model
  status               String    @default("PROPOSED") // PROPOSED | PREPARING | READY | APPROVED | LIVE | SIGNALLED | PARKED | DONE | FAILED | DECLINED | SUPERSEDED
  rung                 Int       @default(1)
  workId               String?
  publicPageId         String?
  proof                String?
  proofSource          String?   // FOUNDER_REPORTED | FOUNDER_LINK | SYSTEM_VERIFIED
  authorizedBy         String?   // FOUNDER | GUARDIAN
  authorizedAt         DateTime?
  actedAt              DateTime?
  reason               String    @default("START")
  previousMoveId       String?
  closeReason          String?
  reply                String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  @@index([objectiveId, createdAt])
  @@index([organizationId, createdAt])
}

model PublicPage {
  id             String    @id @default(cuid())
  slug           String    @unique
  organizationId String
  objectiveId    String
  moveId         String
  status         String    @default("DRAFT") // DRAFT | PUBLISHED | UNPUBLISHED
  headline       String
  subhead        String    @default("")
  body           String
  cta            String
  priceInr       Float?
  views          Int       @default(0)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  responses      PublicResponse[]
  @@index([moveId])
}

model PublicResponse {
  id        String     @id @default(cuid())
  pageId    String
  name      String?
  contact   String
  message   String?
  ipHash    String?
  fromOwner Boolean    @default(false)
  createdAt DateTime   @default(now())
  page      PublicPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@index([pageId, createdAt])
}

